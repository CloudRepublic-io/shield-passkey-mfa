{
    "name": "cloudrepublic/shield-passkey-mfa",
    "description": "Passkey (WebAuthn) MFA action for CodeIgniter Shield, using web-auth/webauthn-lib for the actual cryptography.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "codeigniter4",
        "codeigniter",
        "shield",
        "mfa",
        "2fa",
        "webauthn",
        "passkey",
        "fido2"
    ],
    "homepage": "https://github.com/cloudrepublic-io/shield-passkey-mfa",
    "authors": [
        {
            "name": "Steve Lyons",
            "email": "steve@cloudrepublic.io",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cloudrepublic-io/shield-passkey-mfa/issues",
        "source": "https://github.com/cloudrepublic-io/shield-passkey-mfa"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.6",
        "codeigniter4/shield": "^1.4",
        "web-auth/webauthn-lib": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "PasskeyMfa\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
